---
import { z } from "astro/zod";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GameList from "@/components/match/GameList";
import { createClient } from "@/lib/supabase";
import {
  isMatchFormatId,
  matchErrorMessage,
  matchFormatLabel,
  TOURNAMENT_NAME_MAX_LENGTH,
} from "@/lib/services/matches";
import { parseMatchActions, replayMatch, type Side } from "@/lib/services/scoring";
import { setScoresText, summaryGoals, type SummaryGoalInput } from "@/lib/services/summary";
import type { Match, MatchNote, MatchObservation } from "@/types";

function notFound() {
  return new Response("Nie znaleziono meczu", { status: 404 });
}

function loadFailed() {
  return new Response("Nie udało się wczytać podsumowania meczu", { status: 500 });
}

const parsedId = z.uuid().safeParse(Astro.params.id);
if (!parsedId.success) {
  return notFound();
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return new Response("Supabase nie jest skonfigurowany", { status: 500 });
}

// Under RLS a foreign match is indistinguishable from a missing one: both read as no row.
const { data: match, error: matchError } = await supabase
  .from("matches")
  .select(
    "id, tournament_name, format, with_advantage, first_server, created_at, events, revision, player:players(id, name)",
  )
  .eq("id", parsedId.data)
  .maybeSingle()
  .overrideTypes<Match | null, { merge: false }>();
if (matchError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load match for summary", matchError);
  return loadFailed();
}
if (!match) {
  return notFound();
}

const matchFormat = match.format;
if (!isMatchFormatId(matchFormat)) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Stored match has an unknown format", { id: match.id, format: matchFormat });
  return loadFailed();
}
const parsedLog = parseMatchActions(match.events);
const replay = parsedLog.ok
  ? replayMatch(
      { format: matchFormat, withAdvantage: match.with_advantage, firstServer: match.first_server },
      parsedLog.actions,
    )
  : null;
if (!replay?.ok) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Stored match log cannot be replayed for summary", { id: match.id, revision: match.revision });
  return loadFailed();
}
const state = replay.state;

const { data: observations, error: observationsError } = await supabase
  .from("match_observations")
  .select("id, goal_id")
  .eq("match_id", match.id)
  .overrideTypes<MatchObservation[], { merge: false }>();
if (observationsError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load observations for summary", { id: match.id, error: observationsError });
  return loadFailed();
}

const { data: notes, error: notesError } = await supabase
  .from("match_notes")
  .select("id, text, created_at")
  .eq("match_id", match.id)
  .order("created_at", { ascending: true })
  .overrideTypes<MatchNote[], { merge: false }>();
if (notesError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load notes for summary", { id: match.id, error: notesError });
  return loadFailed();
}

const observedGoalIds = [...new Set(observations.map((observation) => observation.goal_id))];
const goalsQuery = supabase
  .from("player_goals")
  .select("id, text, active, created_at")
  .eq("player_id", match.player.id);
const { data: goals, error: goalsError } = await (
  observedGoalIds.length === 0
    ? goalsQuery.eq("active", true)
    : goalsQuery.or(`active.eq.true,id.in.(${observedGoalIds.join(",")})`)
).overrideTypes<SummaryGoalInput[], { merge: false }>();
if (goalsError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load goals for summary", { id: match.id, error: goalsError });
  return loadFailed();
}
const goalRows = summaryGoals(goals, observations, match.created_at);

const names: Record<Side, string> = { player: match.player.name, opponent: "Przeciwnik" };
const startedAt = new Date(match.created_at).toLocaleString("pl-PL", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "Europe/Warsaw",
});
const noteTime = (createdAt: string) =>
  new Date(createdAt).toLocaleTimeString("pl-PL", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Warsaw" });
const errorMessage = matchErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title="Podsumowanie meczu">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <div class="space-y-6 rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Podsumowanie: {match.player.name}
          </h1>
          <p class="mt-1 text-sm text-blue-100/70">
            {match.tournament_name ?? "Bez nazwy turnieju"} · {startedAt}
          </p>
        </div>

        <p
          id="pending-local-data"
          role="status"
          hidden
          data-match-id={match.id}
          class="rounded-lg border border-yellow-300/40 bg-yellow-500/20 px-3 py-2 text-sm"
        >
          Część zapisu czeka na telefonie —
          <a href={`/matches/${match.id}`} class="underline">
            otwórz mecz
          </a>
          , żeby ją wysłać.
        </p>

        {errorMessage && (
          <p role="alert" class="rounded-lg border border-red-400/40 bg-red-500/20 px-3 py-2 text-sm text-red-100">
            {errorMessage}
          </p>
        )}

        {match.tournament_name === null && (
          <form method="POST" action={`/api/matches/${match.id}/tournament`} class="space-y-2">
            <label for="summary-tournament" class="block text-sm text-blue-100/80">
              Uzupełnij nazwę turnieju
            </label>
            <div class="flex gap-2">
              <input
                id="summary-tournament"
                name="tournament_name"
                type="text"
                required
                maxlength={TOURNAMENT_NAME_MAX_LENGTH}
                class="min-h-12 min-w-0 flex-1 rounded-md border border-white/20 bg-white/10 px-3 text-white"
              />
              <button
                type="submit"
                class="min-h-12 rounded-md bg-purple-600 px-4 font-medium text-white hover:bg-purple-500"
              >
                Zapisz
              </button>
            </div>
          </form>
        )}

        <section aria-labelledby="result-heading" class="space-y-1">
          <h2 id="result-heading" class="text-lg font-semibold">
            Wynik
          </h2>
          <p class="text-2xl font-bold tabular-nums">{setScoresText(state)}</p>
          <p class="text-sm">{state.winner ? `Wygrywa ${names[state.winner]}` : "Mecz niedokończony"}</p>
          <p class="text-xs text-blue-100/70">
            {matchFormatLabel(match.format) ?? match.format} · {match.with_advantage ? "z przewagami" : "bez przewag"}
          </p>
        </section>

        <section aria-labelledby="summary-goals-heading" class="space-y-2">
          <h2 id="summary-goals-heading" class="text-lg font-semibold">
            Cele i obserwacje
          </h2>
          {goalRows.length === 0 ? (
            <p class="text-sm text-blue-100/70">Brak celów w tym meczu</p>
          ) : (
            <ul class="space-y-1 text-sm">
              {goalRows.map((goal) => (
                <li class="flex justify-between gap-3">
                  <span>{goal.text}</span>
                  <span class="font-semibold tabular-nums">{goal.count}</span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section aria-labelledby="summary-notes-heading" class="space-y-2">
          <h2 id="summary-notes-heading" class="text-lg font-semibold">
            Notatki
          </h2>
          {notes.length === 0 ? (
            <p class="text-sm text-blue-100/70">Brak notatek</p>
          ) : (
            <ul class="space-y-1 text-sm">
              {notes.map((note) => (
                <li class="flex gap-2">
                  <span class="text-blue-100/60 tabular-nums">{noteTime(note.created_at)}</span>
                  <span class="min-w-0 flex-1 break-words">{note.text}</span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <GameList history={state.history} names={names} withAdvantage={match.with_advantage} />

        <div class="flex gap-4">
          <a
            href={`/matches/${match.id}`}
            class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            Wróć do meczu
          </a>
          <a href="/matches" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Historia meczów
          </a>
          <a href="/matches/new" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Nowy mecz
          </a>
        </div>

        <details class="rounded-lg border border-red-400/30 bg-red-500/10 px-3 py-2 text-sm">
          <summary class="cursor-pointer font-medium text-red-100">Usuń mecz</summary>
          <div class="mt-3 space-y-3">
            <p>Usunięcia nie da się cofnąć: wynik, obserwacje i notatki tego meczu znikną na zawsze.</p>
            <form method="POST" action={`/api/matches/${match.id}/delete`}>
              <button type="submit" class="min-h-12 rounded-md bg-red-600 px-4 font-medium text-white hover:bg-red-500">
                Tak, usuń mecz trwale
              </button>
            </form>
          </div>
        </details>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { hasPendingLocalData, localDataKeys } from "@/lib/services/summary";

  const banner = document.getElementById("pending-local-data");
  const matchId = banner?.dataset.matchId;
  if (banner && matchId) {
    const keys = localDataKeys(matchId);
    try {
      if (hasPendingLocalData(localStorage.getItem(keys.log), localStorage.getItem(keys.notes))) {
        banner.hidden = false;
      }
    } catch (error) {
      // eslint-disable-next-line no-console -- no error tracker yet; without storage access the banner cannot be decided
      console.error("Failed to read the match copies on the device", error);
    }
  }
</script>
