---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { MATCH_FORMATS, TOURNAMENT_NAME_MAX_LENGTH, matchErrorMessage } from "@/lib/services/matches";
import type { Match, Player } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return new Response("Supabase nie jest skonfigurowany", { status: 500 });
}

const { data: players, error: playersError } = await supabase
  .from("players")
  .select("id, name")
  .order("name", { ascending: true })
  .overrideTypes<Pick<Player, "id" | "name">[], { merge: false }>();
if (playersError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load players", playersError);
  return new Response("Nie udało się wczytać zawodników", { status: 500 });
}

const { data: lastMatches, error: lastMatchError } = await supabase
  .from("matches")
  .select("id, tournament_name, created_at, player:players(id, name)")
  .order("created_at", { ascending: false })
  .limit(1)
  .overrideTypes<Pick<Match, "id" | "tournament_name" | "created_at" | "player">[], { merge: false }>();
if (lastMatchError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load last match", lastMatchError);
  return new Response("Nie udało się wczytać ostatniego meczu", { status: 500 });
}
const lastMatch = lastMatches.at(0);

const errorMessage = matchErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title="Nowy mecz">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Nowy mecz
        </h1>

        {lastMatch && (
          <a
            href={`/matches/${lastMatch.id}`}
            class="mb-6 block rounded-lg border border-white/20 bg-white/5 px-3 py-2 text-sm text-purple-300 transition-colors hover:bg-white/10 hover:text-purple-100"
          >
            Wróć do ostatniego meczu: {lastMatch.player.name}
            {lastMatch.tournament_name && <span class="text-blue-100/70"> · {lastMatch.tournament_name}</span>}
          </a>
        )}

        {errorMessage && (
          <p role="alert" class="mb-4 rounded-lg border border-red-400/40 bg-red-500/20 px-3 py-2 text-sm text-red-100">
            {errorMessage}
          </p>
        )}

        {players.length === 0 ? (
          <div class="space-y-2">
            <p class="text-blue-100/70">Nie masz jeszcze zawodników. Mecz zaczyna się od wyboru zawodnika.</p>
            <a href="/players" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Dodaj zawodnika
            </a>
          </div>
        ) : (
          <form method="POST" action="/api/matches" class="space-y-6">
            <div>
              <label for="match-player" class="mb-2 block text-sm text-blue-100/80">
                Zawodnik
              </label>
              <select
                id="match-player"
                name="player_id"
                required
                class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-blue-100/40 focus:border-purple-300 focus:outline-none"
              >
                {players.map((player) => (
                  <option value={player.id} class="text-black">
                    {player.name}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label for="match-tournament" class="mb-2 block text-sm text-blue-100/80">
                Turniej (opcjonalnie)
              </label>
              <input
                id="match-tournament"
                type="text"
                name="tournament_name"
                maxlength={TOURNAMENT_NAME_MAX_LENGTH}
                placeholder="Możesz zostawić puste"
                class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-blue-100/40 focus:border-purple-300 focus:outline-none"
              />
            </div>

            <fieldset>
              <legend class="mb-2 text-sm text-blue-100/80">Format</legend>
              <div class="space-y-2">
                {MATCH_FORMATS.map((format, index) => (
                  <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white transition-colors hover:bg-white/20 has-[:checked]:border-purple-300 has-[:checked]:bg-white/20">
                    <input type="radio" name="format" value={format.id} checked={index === 0} class="size-5" />
                    {format.label}
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset>
              <legend class="mb-2 text-sm text-blue-100/80">Gemy</legend>
              <div class="space-y-2">
                <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white transition-colors hover:bg-white/20 has-[:checked]:border-purple-300 has-[:checked]:bg-white/20">
                  <input type="radio" name="with_advantage" value="true" checked class="size-5" />Z przewagami
                </label>
                <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white transition-colors hover:bg-white/20 has-[:checked]:border-purple-300 has-[:checked]:bg-white/20">
                  <input type="radio" name="with_advantage" value="false" class="size-5" />
                  Bez przewag (punkt decydujący)
                </label>
              </div>
            </fieldset>

            <fieldset>
              <legend class="mb-2 text-sm text-blue-100/80">Pierwszy serwuje</legend>
              <div class="grid grid-cols-2 gap-2">
                <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white transition-colors hover:bg-white/20 has-[:checked]:border-purple-300 has-[:checked]:bg-white/20">
                  <input type="radio" name="first_server" value="player" required class="size-5" />
                  Zawodnik
                </label>
                <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white transition-colors hover:bg-white/20 has-[:checked]:border-purple-300 has-[:checked]:bg-white/20">
                  <input type="radio" name="first_server" value="opponent" required class="size-5" />
                  Przeciwnik
                </label>
              </div>
            </fieldset>

            <button
              type="submit"
              class="min-h-12 w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
            >
              Rozpocznij mecz
            </button>
          </form>
        )}
      </div>
    </div>
  </div>
</Layout>
