---
import { z } from "astro/zod";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import MatchNotes from "@/components/match/MatchNotes";
import MatchRecorder from "@/components/match/MatchRecorder";
import { isMatchFormatId, matchFormatLabel } from "@/lib/services/matches";
import { parseMatchActions } from "@/lib/services/scoring";
import type { Match, MatchNote, MatchObservation, PlayerGoal } from "@/types";

function notFound() {
  return new Response("Nie znaleziono meczu", { status: 404 });
}

function loadFailed() {
  return new Response("Nie udało się wczytać meczu", { status: 500 });
}

const parsedId = z.uuid().safeParse(Astro.params.id);
if (!parsedId.success) {
  return notFound();
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return new Response("Supabase nie jest skonfigurowany", { status: 500 });
}

// Under RLS a foreign match is indistinguishable from a missing one: both read as no row.
const { data: match, error: queryError } = await supabase
  .from("matches")
  .select(
    "id, tournament_name, format, with_advantage, first_server, created_at, events, revision, player:players(id, name)",
  )
  .eq("id", parsedId.data)
  .maybeSingle()
  .overrideTypes<Match | null, { merge: false }>();
if (queryError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load match", queryError);
  return loadFailed();
}
if (!match) {
  return notFound();
}

const matchFormat = match.format;
if (!isMatchFormatId(matchFormat)) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Stored match has an unknown format", { id: match.id, format: matchFormat });
  return loadFailed();
}
const parsedLog = parseMatchActions(match.events);
if (!parsedLog.ok) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Stored match log is invalid", { id: match.id, revision: match.revision });
  return loadFailed();
}

const { data: observations, error: observationsError } = await supabase
  .from("match_observations")
  .select("id, goal_id")
  .eq("match_id", match.id)
  .order("created_at", { ascending: true })
  .overrideTypes<MatchObservation[], { merge: false }>();
if (observationsError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load observations for match", { id: match.id, error: observationsError });
  return loadFailed();
}

const { data: notes, error: notesError } = await supabase
  .from("match_notes")
  .select("id, text, created_at")
  .eq("match_id", match.id)
  .order("created_at", { ascending: true })
  .overrideTypes<MatchNote[], { merge: false }>();
if (notesError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load notes for match", { id: match.id, error: notesError });
  return loadFailed();
}

// Active goals, plus goals ended during this match that already have observations in it.
const observedGoalIds = [...new Set(observations.map((observation) => observation.goal_id))];
const goalsQuery = supabase
  .from("player_goals")
  .select("id, text, active, created_at")
  .eq("player_id", match.player.id);
const { data: goals, error: goalsError } = await (
  observedGoalIds.length === 0
    ? goalsQuery.eq("active", true)
    : goalsQuery.or(`active.eq.true,id.in.(${observedGoalIds.join(",")})`)
)
  .order("created_at", { ascending: true })
  .overrideTypes<(PlayerGoal & { active: boolean })[], { merge: false }>();
if (goalsError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load goals for match", { id: match.id, error: goalsError });
  return loadFailed();
}

const startedAt = new Date(match.created_at).toLocaleString("pl-PL", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "Europe/Warsaw",
});
const firstServer = match.first_server === "player" ? match.player.name : "Przeciwnik";
---

<Layout title="Mecz">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {match.player.name}
        </h1>

        <MatchNotes
          client:load
          matchId={match.id}
          playerId={match.player.id}
          goals={goals.map(({ id, text, active }) => ({ id, text, active }))}
          initialObservations={observations}
          initialNotes={notes}
        />

        <MatchRecorder
          client:load
          matchId={match.id}
          playerName={match.player.name}
          format={matchFormat}
          withAdvantage={match.with_advantage}
          firstServer={match.first_server}
          initialActions={parsedLog.actions}
          initialRevision={match.revision}
        />

        <dl class="mb-6 space-y-3 text-sm">
          <div>
            <dt class="text-blue-100/70">Turniej</dt>
            <dd>{match.tournament_name ?? "Bez nazwy turnieju"}</dd>
          </div>
          <div>
            <dt class="text-blue-100/70">Format</dt>
            <dd>{matchFormatLabel(match.format) ?? match.format}</dd>
          </div>
          <div>
            <dt class="text-blue-100/70">Gemy</dt>
            <dd>{match.with_advantage ? "z przewagami" : "bez przewag"}</dd>
          </div>
          <div>
            <dt class="text-blue-100/70">Pierwszy serwuje</dt>
            <dd>{firstServer}</dd>
          </div>
          <div>
            <dt class="text-blue-100/70">Rozpoczęty</dt>
            <dd>{startedAt}</dd>
          </div>
        </dl>

        <div class="flex gap-4">
          <a
            href={`/matches/${match.id}/summary`}
            class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            Podsumowanie meczu
          </a>
          <a href="/matches/new" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Nowy mecz
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
