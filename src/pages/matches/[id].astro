---
import { z } from "astro/zod";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import MatchRecorder from "@/components/match/MatchRecorder";
import { isMatchFormatId, matchFormatLabel } from "@/lib/services/matches";
import { parseMatchActions } from "@/lib/services/scoring";
import type { Match } from "@/types";

function notFound() {
  return new Response("Nie znaleziono meczu", { status: 404 });
}

function loadFailed() {
  return new Response("Nie udało się wczytać meczu", { status: 500 });
}

const parsedId = z.uuid().safeParse(Astro.params.id);
if (!parsedId.success) {
  return notFound();
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return new Response("Supabase nie jest skonfigurowany", { status: 500 });
}

// Under RLS a foreign match is indistinguishable from a missing one: both read as no row.
const { data: match, error: queryError } = await supabase
  .from("matches")
  .select(
    "id, tournament_name, format, with_advantage, first_server, created_at, events, revision, player:players(name)",
  )
  .eq("id", parsedId.data)
  .maybeSingle()
  .overrideTypes<Match | null, { merge: false }>();
if (queryError) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Failed to load match", queryError);
  return loadFailed();
}
if (!match) {
  return notFound();
}

const matchFormat = match.format;
if (!isMatchFormatId(matchFormat)) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Stored match has an unknown format", { id: match.id, format: matchFormat });
  return loadFailed();
}
const parsedLog = parseMatchActions(match.events);
if (!parsedLog.ok) {
  // eslint-disable-next-line no-console -- no error tracker yet; the server log is the only place this failure is visible
  console.error("Stored match log is invalid", { id: match.id, revision: match.revision });
  return loadFailed();
}

const startedAt = new Date(match.created_at).toLocaleString("pl-PL", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "Europe/Warsaw",
});
const firstServer = match.first_server === "player" ? match.player.name : "Przeciwnik";
---

<Layout title="Mecz">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {match.player.name}
        </h1>

        <MatchRecorder
          client:load
          matchId={match.id}
          playerName={match.player.name}
          format={matchFormat}
          withAdvantage={match.with_advantage}
          firstServer={match.first_server}
          initialActions={parsedLog.actions}
          initialRevision={match.revision}
        />

        <dl class="mb-6 space-y-3 text-sm">
          <div>
            <dt class="text-blue-100/70">Turniej</dt>
            <dd>{match.tournament_name ?? "Bez nazwy turnieju"}</dd>
          </div>
          <div>
            <dt class="text-blue-100/70">Format</dt>
            <dd>{matchFormatLabel(match.format) ?? match.format}</dd>
          </div>
          <div>
            <dt class="text-blue-100/70">Gemy</dt>
            <dd>{match.with_advantage ? "z przewagami" : "bez przewag"}</dd>
          </div>
          <div>
            <dt class="text-blue-100/70">Pierwszy serwuje</dt>
            <dd>{firstServer}</dd>
          </div>
          <div>
            <dt class="text-blue-100/70">Rozpoczęty</dt>
            <dd>{startedAt}</dd>
          </div>
        </dl>

        <a href="/matches/new" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Nowy mecz
        </a>
      </div>
    </div>
  </div>
</Layout>
